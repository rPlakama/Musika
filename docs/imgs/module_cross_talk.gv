digraph musika_cross_talk {
  rankdir     = TB;
  newrank     = true;
  compound    = true;
  concentrate = false;
  splines     = spline;
  nodesep     = 0.35;
  ranksep     = 1.4;
  pad         = 0.5;
  size        = "8,32!";
  ratio       = "fill";
  bgcolor     = "#0f1117";
  fontname    = "sans-serif";
  fontcolor   = "#e9ecef";
  labelloc    = "t";
  label       = <<B>Musika — Module Cross-Talk (Vertical Tier Architecture)</B><br/><font point-size="10" color="#909296">Top-to-Bottom Layer Flow</font>>;

  node [fontname="sans-serif", fontsize=11, shape=box, style="rounded,filled",
        fontcolor="#e9ecef", margin="0.14,0.08", width=1.5, height=0.38, fixedsize=false];
  edge [arrowsize=0.55, penwidth=1.2];

  /* ════════════════════════════════════════════════════
     1. UI / QML LAYER
     ════════════════════════════════════════════════════ */
  subgraph cluster_ui {
    label="1. UI / QML Layer"; fontcolor="#ff8787";
    style="dashed,rounded"; color="#c92a2a"; bgcolor="#1a0b0b";
    qml         [label="qml",         fillcolor="#4d0b0b", color="#ff8787"];
    qml_backend [label="qml_backend", fillcolor="#4d0b0b", color="#ff8787"];
    browse      [label="browse",      fillcolor="#4d0b0b", color="#ff8787"];
    keybind     [label="keybind",     fillcolor="#4d0b0b", color="#ff8787"];
    palette     [label="palette",     fillcolor="#4d0b0b", color="#ff8787"];

    /* Internal vertical stacking */
    qml -> qml_backend -> browse [style=invis];
  }

  /* ════════════════════════════════════════════════════
     2. APP STATE LAYER
     ════════════════════════════════════════════════════ */
  subgraph cluster_app {
    label="2. App State"; fontcolor="#8ce99a";
    style="dashed,rounded"; color="#2f9e44"; bgcolor="#0a1a0d";
    app    [label="app",    fillcolor="#1a3d1f", color="#8ce99a"];
    status [label="status", fillcolor="#1a3d1f", color="#8ce99a"];
  }

  /* ════════════════════════════════════════════════════
     3. PLAYBACK ENGINE
     ════════════════════════════════════════════════════ */
  subgraph cluster_playback {
    label="3. Playback Engine"; fontcolor="#74c0fc";
    style="dashed,rounded"; color="#1971c2"; bgcolor="#071526";
    player    [label="player",    fillcolor="#0b2040", color="#74c0fc"];
    queue     [label="queue",     fillcolor="#0b2040", color="#74c0fc"];
    mpris     [label="mpris",     fillcolor="#0b2040", color="#74c0fc"];
    playlists [label="playlists", fillcolor="#0b2040", color="#74c0fc"];

    player -> queue -> playlists [style=invis];
  }

  /* ════════════════════════════════════════════════════
     4. LIBRARY & METADATA
     ════════════════════════════════════════════════════ */
  subgraph cluster_library {
    label="4. Library & Metadata"; fontcolor="#ffe066";
    style="dashed,rounded"; color="#f08c00"; bgcolor="#211603";
    index       [label="index",       fillcolor="#5c3d0e", color="#ffe066"];
    library     [label="library",     fillcolor="#5c3d0e", color="#ffe066"];
    search      [label="search",      fillcolor="#5c3d0e", color="#ffe066"];
    artist_user [label="artist_user", fillcolor="#5c3d0e", color="#ffe066"];

    index -> library -> search [style=invis];
  }

  /* ════════════════════════════════════════════════════
     5. MEDIA ASSETS
     ════════════════════════════════════════════════════ */
  subgraph cluster_media_assets {
    label="5. Media Assets"; fontcolor="#e599f7";
    style="dashed,rounded"; color="#9c36b5"; bgcolor="#170521";
    covers   [label="covers",   fillcolor="#3a0d4d", color="#e599f7"];
    colors   [label="colors",   fillcolor="#3a0d4d", color="#e599f7"];
    lyrics   [label="lyrics",   fillcolor="#3a0d4d", color="#e599f7"];
    media    [label="media",    fillcolor="#3a0d4d", color="#e599f7"];
    download [label="download", fillcolor="#3a0d4d", color="#e599f7"];
    offline  [label="offline",  fillcolor="#3a0d4d", color="#e599f7"];

    covers -> colors -> lyrics -> media [style=invis];
  }

  /* ════════════════════════════════════════════════════
     6. NETWORK LAYER
     ════════════════════════════════════════════════════ */
  subgraph cluster_net {
    label="6. Network Layer"; fontcolor="#ffa94d";
    style="dashed,rounded"; color="#e8590c"; bgcolor="#1f0c00";
    api         [label="api",         fillcolor="#4d2000", color="#ffa94d"];
    session     [label="session",     fillcolor="#4d2000", color="#ffa94d"];
    http_client [label="http_client", fillcolor="#4d2000", color="#ffa94d"];

    api -> session -> http_client [style=invis];
  }

  /* ════════════════════════════════════════════════════
     7. PERSISTENCE LAYER
     ════════════════════════════════════════════════════ */
  subgraph cluster_db {
    label="7. Persistence Layer"; fontcolor="#66d9e8";
    style="dashed,rounded"; color="#0c8599"; bgcolor="#03181f";
    db           [label="db",            fillcolor="#0b3d4d", color="#66d9e8"];
    sqlite       [label="sqlite",        fillcolor="#0b3d4d", color="#66d9e8"];
    ipc          [label="ipc",           fillcolor="#0b3d4d", color="#66d9e8"];
    scroll_memory[label="scroll_memory", fillcolor="#0b3d4d", color="#66d9e8"];

    db -> sqlite -> ipc [style=invis];
  }

  /* ════════════════════════════════════════════════════
     8. INFRASTRUCTURE LAYER
     ════════════════════════════════════════════════════ */
  subgraph cluster_infra {
    label="8. Infrastructure Layer"; fontcolor="#b197fc";
    style="dashed,rounded"; color="#7048e8"; bgcolor="#110b24";
    consts   [label="consts",  fillcolor="#2b1f4e", color="#b197fc"];
    cache    [label="cache",   fillcolor="#2b1f4e", color="#b197fc"];
    fanout   [label="fanout",  fillcolor="#2b1f4e", color="#b197fc"];
    digest   [label="digest",  fillcolor="#2b1f4e", color="#b197fc"];
    crypto   [label="crypto",  fillcolor="#2b1f4e", color="#b197fc"];
    hex      [label="hex",     fillcolor="#2b1f4e", color="#b197fc"];

    consts -> cache -> fanout -> digest -> crypto -> hex [style=invis];
  }

  /* STRICT VERTICAL CHAIN (Forces Clusters 1 through 8 into a tall single column) */
  qml -> app -> player -> index -> covers -> api -> db -> consts [style=invis];

  /* ════════════════════════════════════════════════════
     DEPENDENCY EDGES
     ════════════════════════════════════════════════════ */

  /* Infra */
  digest      -> hex         [color="#9775fa"];
  crypto      -> hex         [color="#9775fa"];
  crypto      -> db          [color="#9775fa"];
  fanout      -> consts      [color="#9775fa"];

  /* Network */
  http_client -> consts      [color="#ff922b"];
  http_client -> digest      [color="#ff922b"];
  api         -> http_client [color="#ff922b"];
  session     -> http_client [color="#ff922b"];
  session     -> db          [color="#ff922b"];
  session     -> sqlite      [color="#ff922b"];
  sqlite      -> crypto      [color="#66d9e8"];

  /* App State */
  app         -> db          [color="#69db7c"];
  app         -> search      [color="#69db7c"];

  /* Persistence */
  db          -> ipc         [color="#3bc9db"];
  db          -> search      [color="#3bc9db"];
  ipc         -> db          [color="#3bc9db"];
  scroll_memory -> db        [color="#3bc9db"];

  /* Library */
  library     -> api         [color="#ffe066"];
  library     -> cache       [color="#ffe066"];
  library     -> consts      [color="#ffe066"];
  library     -> db          [color="#ffe066"];
  library     -> search      [color="#ffe066"];
  search      -> cache       [color="#fcc419"];
  search      -> library     [color="#fcc419"];
  artist_user -> cache       [color="#ffe066"];
  artist_user -> consts      [color="#ffe066"];

  /* Index Fan-out */
  index       -> api         [color="#ffd43b", penwidth=1.6, constraint=false];
  index       -> artist_user [color="#ffd43b", penwidth=1.6];
  index       -> cache       [color="#ffd43b", penwidth=1.6, constraint=false];
  index       -> colors      [color="#ffd43b", penwidth=1.6];
  index       -> consts      [color="#ffd43b", penwidth=1.6, constraint=false];
  index       -> covers      [color="#ffd43b", penwidth=1.6];
  index       -> db          [color="#ffd43b", penwidth=1.6, constraint=false];
  index       -> fanout      [color="#ffd43b", penwidth=1.6, constraint=false];
  index       -> http_client [color="#ffd43b", penwidth=1.6, constraint=false];
  index       -> library     [color="#ffd43b", penwidth=1.6];
  index       -> lyrics      [color="#ffd43b", penwidth=1.6];
  index       -> media       [color="#ffd43b", penwidth=1.6];
  index       -> playlists   [color="#ffd43b", penwidth=1.6];
  index       -> search      [color="#ffd43b", penwidth=1.6];

  /* Media Assets */
  covers      -> app         [color="#e599f7"];
  covers      -> cache       [color="#e599f7"];
  covers      -> consts      [color="#e599f7"];
  covers      -> db          [color="#e599f7"];
  covers      -> digest      [color="#e599f7"];
  covers      -> http_client [color="#e599f7"];
  covers      -> session     [color="#e599f7"];
  colors      -> cache       [color="#cc5de8"];
  colors      -> consts      [color="#cc5de8"];
  colors      -> covers      [color="#cc5de8"];
  colors      -> db          [color="#cc5de8"];
  colors      -> digest      [color="#cc5de8"];
  lyrics      -> api         [color="#da77f2"];
  lyrics      -> cache       [color="#da77f2"];
  lyrics      -> consts      [color="#da77f2"];
  lyrics      -> db          [color="#da77f2"];
  lyrics      -> fanout      [color="#da77f2"];
  lyrics      -> http_client [color="#da77f2"];
  lyrics      -> library     [color="#da77f2"];
  media       -> cache       [color="#e599f7"];
  media       -> consts      [color="#e599f7"];
  media       -> db          [color="#e599f7"];
  media       -> digest      [color="#e599f7"];
  media       -> library     [color="#e599f7"];
  download    -> cache       [color="#b197fc"];
  download    -> consts      [color="#b197fc"];
  download    -> db          [color="#b197fc"];
  offline     -> db          [color="#9c36b5"];
  offline     -> download    [color="#9c36b5"];
  offline     -> library     [color="#9c36b5"];

  /* Playback Engine */
  player      -> app         [color="#74c0fc"];
  player      -> consts      [color="#74c0fc"];
  player      -> library     [color="#74c0fc"];
  mpris       -> app         [color="#4dabf7"];
  queue       -> browse      [color="#74c0fc"];
  queue       -> consts      [color="#74c0fc"];
  queue       -> covers      [color="#74c0fc"];
  queue       -> db          [color="#74c0fc"];
  queue       -> download    [color="#74c0fc"];
  queue       -> http_client [color="#74c0fc"];
  queue       -> library     [color="#74c0fc"];
  queue       -> media       [color="#74c0fc"];
  queue       -> offline     [color="#74c0fc"];
  queue       -> session     [color="#74c0fc"];
  queue       -> status      [color="#74c0fc"];
  playlists   -> browse      [color="#4dabf7"];
  playlists   -> consts      [color="#4dabf7"];
  playlists   -> covers      [color="#4dabf7"];
  playlists   -> db          [color="#4dabf7"];
  playlists   -> http_client [color="#4dabf7"];
  playlists   -> library     [color="#4dabf7"];
  playlists   -> offline     [color="#4dabf7"];
  playlists   -> session     [color="#4dabf7"];

  /* UI / Browse Navigation */
  browse      -> app         [color="#ff8787"];
  browse      -> artist_user [color="#ff8787"];
  browse      -> covers      [color="#ff8787"];
  browse      -> db          [color="#ff8787"];
  browse      -> library     [color="#ff8787"];
  browse      -> offline     [color="#ff8787"];
  browse      -> playlists   [color="#ff8787"];
  browse      -> queue       [color="#ff8787"];
  browse      -> search      [color="#ff8787"];
  browse      -> session     [color="#ff8787"];

  /* QML Frontend Orchestration */
  qml -> app          [color="#ff6b6b", penwidth=1.8];
  qml -> artist_user  [color="#ff6b6b", penwidth=1.8, constraint=false];
  qml -> browse       [color="#ff6b6b", penwidth=1.8];
  qml -> cache        [color="#ff6b6b", penwidth=1.8, constraint=false];
  qml -> colors       [color="#ff6b6b", penwidth=1.8, constraint=false];
  qml -> consts       [color="#ff6b6b", penwidth=1.8, constraint=false];
  qml -> covers       [color="#ff6b6b", penwidth=1.8, constraint=false];
  qml -> db           [color="#ff6b6b", penwidth=1.8, constraint=false];
  qml -> download     [color="#ff6b6b", penwidth=1.8, constraint=false];
  qml -> ipc          [color="#ff6b6b", penwidth=1.8, constraint=false];
  qml -> keybind      [color="#ff6b6b", penwidth=1.8];
  qml -> library      [color="#ff6b6b", penwidth=1.8, constraint=false];
  qml -> lyrics       [color="#ff6b6b", penwidth=1.8, constraint=false];
  qml -> mpris        [color="#ff6b6b", penwidth=1.8];
  qml -> offline      [color="#ff6b6b", penwidth=1.8, constraint=false];
  qml -> player       [color="#ff6b6b", penwidth=1.8];
  qml -> playlists    [color="#ff6b6b", penwidth=1.8];
  qml -> queue        [color="#ff6b6b", penwidth=1.8];
  qml -> scroll_memory[color="#ff6b6b", penwidth=1.8, constraint=false];
  qml -> session      [color="#ff6b6b", penwidth=1.8, constraint=false];
  qml -> status       [color="#ff6b6b", penwidth=1.8];

  /* QML Backend Bridge */
  qml_backend -> app         [color="#fa5252", penwidth=1.6];
  qml_backend -> artist_user [color="#fa5252", penwidth=1.6, constraint=false];
  qml_backend -> browse      [color="#fa5252", penwidth=1.6];
  qml_backend -> consts      [color="#fa5252", penwidth=1.6, constraint=false];
  qml_backend -> covers      [color="#fa5252", penwidth=1.6, constraint=false];
  qml_backend -> db          [color="#fa5252", penwidth=1.6, constraint=false];
  qml_backend -> download    [color="#fa5252", penwidth=1.6, constraint=false];
  qml_backend -> http_client [color="#fa5252", penwidth=1.6, constraint=false];
  qml_backend -> index       [color="#fa5252", penwidth=1.6, constraint=false];
  qml_backend -> library     [color="#fa5252", penwidth=1.6, constraint=false];
  qml_backend -> media       [color="#fa5252", penwidth=1.6, constraint=false];
  qml_backend -> mpris       [color="#fa5252", penwidth=1.6];
  qml_backend -> offline     [color="#fa5252", penwidth=1.6, constraint=false];
  qml_backend -> session     [color="#fa5252", penwidth=1.6, constraint=false];
  qml_backend -> sqlite      [color="#fa5252", penwidth=1.6, constraint=false];
}
