@startuml
Participant "Qml Engine\n" as qml_engine
Participant "C++ Proxy\n <<QAbstractItemModel>>" as cpp_proxy
Participant "Rust Proxy\n" as rust_proxy
Participant "Backend\n<<QAbstractItemModel trait>>" as backend

qml_engine -> cpp_proxy: rowCount()
cpp_proxy -> rust_proxy: row_count()
group borrowing scope
    rust_proxy -> backend: Rc::try_borrow()
    backend --> rust_proxy: &Backend
    rust_proxy -> backend: row_count()
    backend --> rust_proxy : return row count
end
rust_proxy --> cpp_proxy : return row count
cpp_proxy --> qml_engine : return row count
@enduml
